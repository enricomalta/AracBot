# Supabase Postgres (use the Supavisor transaction-pooler connection string)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Vercel and cron-job.org
PUBLIC_BASE_URL=https://your-project.vercel.app
CRON_TRIGGER_SECRET=generate_a_long_random_secret
QSTASH_TOKEN=your_qstash_token
QSTASH_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# Browser authentication for the purchase-approval endpoint. The future web UI
# must store the Supabase access token in this HttpOnly cookie and send the
# matching csrf_token cookie/header pair with credentials: 'include'.
AUTH_COOKIE_NAME=sb-access-token
CSRF_COOKIE_NAME=csrf_token

# Monitoring and notifications
SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Trading is deliberately disabled by default. A human-approved purchase and
# automatic exits require both this flag and valid Binance credentials.
ENABLE_LIVE_TRADING=false

# Binance API Configuration
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
# Optional override/fallbacks when an ISP or company network blocks api.binance.com.
BINANCE_API_URL=https://api.binance.com/api/v3/klines
BINANCE_API_FALLBACK_URLS=https://data-api.binance.vision/api/v3/klines,https://api.binance.us/api/v3/klines

# Trading Configuration
USE_BINANCE_DEMO=true  # Set to false for real trading (USE WITH CAUTION!)

# Sentiment Analysis Configuration (KILL SWITCH)
SENTIMENT_ENABLED=true  # Set to false to disable sentiment analysis feature
